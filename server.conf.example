# 服务配置文件示例
# 使用前请复制为 server.conf 并修改相应配置

[db]
# 数据库主机地址（Docker 环境使用容器名）
host = license_mysql
# 数据库端口
port = 3306
# 数据库用户名
user = license_user
# 数据库密码（请修改为强密码）
password = your_secure_password_here
# 数据库名称
dbname = license_db

[server]
# 服务监听地址（0.0.0.0 表示监听所有网卡）
host = 0.0.0.0
# 服务端口
port = 2712
# 调试模式（生产环境请设置为 false）
debug = false
